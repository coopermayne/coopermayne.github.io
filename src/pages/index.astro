---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <h1>cooper mayne</h1>
  <Projects />
  <Contact />
</Layout>

<script>
  import Velocity from 'velocity-animate';

  function mobilecheck() {
    return window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  }

  function resetSpans() {
    document.querySelectorAll('span').forEach(function (span) {
      span.classList.remove('ab');
      (span as HTMLElement).style.top = '';
      (span as HTMLElement).style.left = '';
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    if (mobilecheck()) {
      Velocity(document.querySelector('.cover'), { opacity: 0 }, { duration: 250, delay: 100 });
    } else {
      var meEl = document.getElementById('me');
      if (meEl) {
        meEl.addEventListener('mouseenter', function () {
          Velocity(this, { rotateZ: '10' }, 50);
          Velocity(this, { rotateZ: '-10' }, 50);
          Velocity(this, { rotateZ: '0deg' }, 50);
        });
      }

      //------------------------------------------------------------------------------------------------------------------------
      //put a span around each character --- and position them absolutely (to optimize rendering)
      var textEls = document.querySelectorAll('h1, h2, p');

      textEls.forEach(function (v) {
        var html = v.innerHTML.trim();
        var new_html = '';
        var ignore = false;
        for (var i = 0, len = html.length; i < len; i++) {
          if (html[i] == '<') {
            ignore = true;
          }
          if (!ignore) {
            new_html += '<span>' + html[i] + '</span>';
          } else {
            new_html += html[i];
          }
          if (html[i] == '>') {
            ignore = false;
          }
        }
        v.innerHTML = new_html;
      });

      var spanEls = document.querySelectorAll('span');
      var list: [HTMLElement, number, number][] = [];

      spanEls.forEach(function (el) {
        var htmlEl = el as HTMLElement;
        list.push([htmlEl, htmlEl.offsetTop, htmlEl.offsetLeft]);
      });

      //position absolute
      list.forEach(function (v) {
        var elem = v[0];
        var top = v[1];
        var left = v[2];
        elem.classList.add('ab');
        elem.style.top = top + 'px';
        elem.style.left = left + 'px';
      });

      //end span and positioning
      //------------------------------------------------------------------------------------------------------------------------

      var distance = function () {
        var direc = [1, -1];
        var base = 200;
        var direction = direc[Math.floor(Math.random() * direc.length)];
        return direction * Math.random() * base;
      };

      var time = function (i: number) {
        var base = 1;
        return 250 + base * i;
      };

      var counter = 0;
      var totalSpans = spanEls.length;

      Velocity(document.querySelector('.cover'), { opacity: 0 }, { duration: 4000, delay: 500 });

      var choice = Math.round(Math.random());
      if (choice == 0) {
        var pickEasing = function () {
          return [10, 1];
        };

        Velocity(
          spanEls,
          {
            translateX: [
              function () {
                return distance() * 2;
              },
              function () {
                return distance() * 2;
              },
            ],
            translateY: [
              function () {
                return distance() * 2;
              },
              function () {
                return distance() * 2;
              },
            ],
          },
          {
            delay: 500,
            duration: 1500,
            easing: 'linear',
          }
        );

        Velocity(
          spanEls,
          {
            translateX: function () {
              return distance();
            },
            translateY: function () {
              return distance();
            },
          },
          {
            duration: 500,
            easing: pickEasing(),
          }
        );

        Velocity(
          spanEls,
          {
            translateX: function () {
              return distance() / 2;
            },
            translateY: function () {
              return distance() / 2;
            },
          },
          {
            delay: 150,
            duration: 250,
            easing: pickEasing(),
          }
        );

        Velocity(
          spanEls,
          {
            translateX: function () {
              return distance() / 4;
            },
            translateY: function () {
              return distance() / 4;
            },
          },
          {
            delay: 150,
            duration: 250,
            easing: pickEasing(),
          }
        );

        Velocity(
          spanEls,
          {
            translateX: function () {
              return distance() / 10;
            },
            translateY: function () {
              return distance() / 10;
            },
          },
          {
            delay: 150,
            duration: 250,
            easing: pickEasing(),
          }
        );

        Velocity(
          spanEls,
          {
            translateX: 0,
            translateY: 0,
          },
          {
            delay: 150,
            duration: 250,
            easing: pickEasing(),
            complete: function () {
              counter++;
              if (counter == totalSpans) {
                resetSpans();
                window.addEventListener('resize', resetSpans);
              }
            },
          }
        );
      } else if (choice == 1) {
        for (var i = 0, len = spanEls.length; i < len; i++) {
          var ds = [
            { x: distance() * 4, y: distance() * 2 },
            { x: distance() * 3, y: distance() * 2 },
            { x: distance() * 2, y: distance() * 1.5 },
            { x: distance(), y: distance() },
            { x: distance() / 2, y: distance() / 2 },
          ];

          Velocity(
            spanEls[i],
            {
              translateX: [ds[1].x, ds[0].x],
              translateY: [ds[1].y, ds[0].y],
            },
            {
              duration: 500 + Math.random() * 2500,
            }
          );

          Velocity(
            spanEls[i],
            {
              translateX: [ds[2].x, ds[1].x],
              translateY: [ds[2].y, ds[1].y],
            },
            {
              duration: 500 + Math.random() * 2500,
            }
          );

          Velocity(
            spanEls[i],
            {
              translateX: [ds[3].x, ds[2].x],
              translateY: [ds[3].y, ds[2].y],
            },
            {
              duration: 250 + Math.random() * 750,
            }
          );

          Velocity(
            spanEls[i],
            {
              translateX: [ds[4].x, ds[3].x],
              translateY: [ds[4].y, ds[3].y],
            },
            {
              duration: time(i),
            }
          );

          Velocity(
            spanEls[i],
            {
              translateX: 0,
              translateY: 0,
            },
            {
              duration: time(i),
              complete: function () {
                counter++;
                if (counter == totalSpans) {
                  resetSpans();
                  window.addEventListener('resize', resetSpans);
                }
              },
            }
          );
        }
      }
    }
  });
</script>
