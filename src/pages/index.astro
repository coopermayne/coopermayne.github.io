---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <h1 aria-label="cooper mayne">cooper mayne</h1>
  <Projects />
  <Contact />
</Layout>

<script>
  const isMobile = window.matchMedia('(max-width: 768px)').matches
    || window.matchMedia('(pointer: coarse)').matches;

  const cover = document.querySelector('.cover') as HTMLElement;

  if (isMobile) {
    // On mobile, just fade the cover out quickly
    cover.animate([{ opacity: 1 }, { opacity: 0 }], {
      duration: 300,
      delay: 100,
      fill: 'forwards',
    });
  } else {
    // --- Desktop: character-scatter animation ---

    // Wrap each text character in animatable spans (skip HTML tags)
    const els = document.querySelectorAll<HTMLElement>('h1, h2, p');

    els.forEach((el) => {
      // Store the full text for screen readers
      const fullText = el.textContent || '';
      el.setAttribute('aria-label', fullText);

      const html = el.innerHTML.trim();
      let newHtml = '';
      let insideTag = false;

      for (let i = 0; i < html.length; i++) {
        if (html[i] === '<') insideTag = true;

        if (!insideTag) {
          newHtml += `<span class="anim-char" aria-hidden="true">${html[i]}</span>`;
        } else {
          newHtml += html[i];
        }

        if (html[i] === '>') insideTag = false;
      }

      el.innerHTML = newHtml;
    });

    // Collect all character spans and record their positions
    const spans = document.querySelectorAll<HTMLElement>('.anim-char');
    const positions: { el: HTMLElement; top: number; left: number }[] = [];

    spans.forEach((span) => {
      const rect = span.getBoundingClientRect();
      const parentRect = span.offsetParent?.getBoundingClientRect() || { top: 0, left: 0 };
      positions.push({
        el: span,
        top: rect.top - parentRect.top,
        left: rect.left - parentRect.left,
      });
    });

    // Position absolutely for animation
    positions.forEach(({ el, top, left }) => {
      el.classList.add('ab');
      el.style.top = `${top}px`;
      el.style.left = `${left}px`;
    });

    // Helper: random distance for scatter
    function distance(): number {
      const direction = Math.random() < 0.5 ? 1 : -1;
      return direction * Math.random() * 200;
    }

    // Fade the cover out slowly
    cover.animate([{ opacity: 1 }, { opacity: 0 }], {
      duration: 4000,
      delay: 500,
      fill: 'forwards',
    });

    // Choose one of two animation patterns
    const choice = Math.round(Math.random());

    if (choice === 0) {
      // Pattern A: staged scatter with decreasing magnitude
      const stages = [
        { scale: 2, duration: 1500, delay: 500 },
        { scale: 1, duration: 500, delay: 0 },
        { scale: 0.5, duration: 250, delay: 150 },
        { scale: 0.25, duration: 250, delay: 150 },
        { scale: 0.1, duration: 250, delay: 150 },
      ];

      const animations: Animation[] = [];

      spans.forEach((span) => {
        const keyframes: Keyframe[] = [{ transform: 'translate(0, 0)', offset: 0 }];

        let cumulativeTime = 0;
        const totalTime = stages.reduce((sum, s) => sum + s.duration + s.delay, 0);

        stages.forEach((stage, idx) => {
          cumulativeTime += stage.delay + stage.duration;
          const offset = cumulativeTime / totalTime;

          if (idx < stages.length - 1) {
            const dx = distance() * stage.scale;
            const dy = distance() * stage.scale;
            keyframes.push({
              transform: `translate(${dx}px, ${dy}px)`,
              offset: Math.min(offset, 1),
            });
          } else {
            // Final stage: return to origin
            keyframes.push({
              transform: 'translate(0, 0)',
              offset: 1,
            });
          }
        });

        const anim = span.animate(keyframes, {
          duration: totalTime,
          delay: 500,
          easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)',
          fill: 'forwards',
        });

        animations.push(anim);
      });

      // When all animations complete, clean up absolute positioning
      Promise.all(animations.map((a) => a.finished)).then(() => {
        cleanup(spans);
      });
    } else {
      // Pattern B: per-character staggered animation with random durations
      const animations: Animation[] = [];

      spans.forEach((span, i) => {
        const waypoints = [
          { x: distance() * 4, y: distance() * 2 },
          { x: distance() * 3, y: distance() * 2 },
          { x: distance() * 2, y: distance() * 1.5 },
          { x: distance(), y: distance() },
          { x: distance() / 2, y: distance() / 2 },
        ];

        const durations = [
          500 + Math.random() * 2500,
          500 + Math.random() * 2500,
          250 + Math.random() * 750,
          250 + i,
          250 + i,
        ];

        const totalDuration = durations.reduce((sum, d) => sum + d, 0);

        let cumulative = 0;
        const keyframes: Keyframe[] = [
          { transform: `translate(${waypoints[0].x}px, ${waypoints[0].y}px)`, offset: 0 },
        ];

        for (let j = 1; j < waypoints.length; j++) {
          cumulative += durations[j - 1];
          keyframes.push({
            transform: `translate(${waypoints[j].x}px, ${waypoints[j].y}px)`,
            offset: cumulative / totalDuration,
          });
        }

        cumulative += durations[durations.length - 1];
        keyframes.push({ transform: 'translate(0, 0)', offset: 1 });

        const anim = span.animate(keyframes, {
          duration: totalDuration,
          easing: 'ease-out',
          fill: 'forwards',
        });

        animations.push(anim);
      });

      Promise.all(animations.map((a) => a.finished)).then(() => {
        cleanup(spans);
      });
    }
  }

  function cleanup(spans: NodeListOf<HTMLElement>) {
    spans.forEach((span) => {
      span.classList.remove('ab');
      span.style.top = '';
      span.style.left = '';
    });
  }
</script>
