---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'cooper mayne - web developer',
  description = 'profile of a human being who makes websites sometimes'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google" content="notranslate" />
    <meta name="google-site-verification" content="SWOt4mMxz7rNbswF-GbW-Vu59be2OXGdsAoniNyCGo8" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="cover"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
    --font-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
  }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-body);
    width: 90%;
    max-width: 500px;
    margin: 20px auto 0 auto;
    margin-top: 5% !important;
    color: #1a1a1a;
    background: #fff;
  }

  h1, h2, h3 {
    font-family: var(--font-display);
  }

  a {
    color: #2a5db0;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  a:hover {
    border-bottom-color: #2a5db0;
  }

  #me {
    position: fixed;
    bottom: 20px;
    left: 20px;
    height: 10%;
    z-index: 2;
  }

  span {
    position: relative;
  }

  .ab {
    position: absolute;
  }

  .cover {
    pointer-events: none;
    background: #fff;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  @media (prefers-color-scheme: dark) {
    body {
      color: #e0e0e0;
      background: #1a1a1a;
    }

    a {
      color: #6da3e8;
    }

    a:hover {
      border-bottom-color: #6da3e8;
    }

    .cover {
      background: #1a1a1a;
    }
  }
</style>
